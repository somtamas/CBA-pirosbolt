<Window x:Class="CBA_pirosbolt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CBA_pirosbolt"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel Background="Red">
        <TextBlock FontWeight="Bold" FontStyle="Italic" Foreground="White" Text="CBA Adminisztrátori felület" Height="20" DockPanel.Dock="Top" FontSize="15"/>
        <StackPanel
            Width="200"
            Background="IndianRed"
            DockPanel.Dock="Left" Height="415">
            <ListView Height="400" Background="IndianRed">
                <ListViewItem
                    x:Name="productMenu"
                    Content="Termékek"
                    MouseLeftButtonUp="diakMenu_MouseLeftButtonUp"
                    FontSize="14"
                    BorderBrush="Pink"
                    BorderThickness="2"
                    Foreground="MediumVioletRed"
                    FontWeight="Bold"/>
                <ListViewItem
                    x:Name="walletMenu"
                    Content="Vásárló"
                    MouseLeftButtonUp="tanarMenu_MouseLeftButtonUp"
                    FontSize="14"
                    BorderBrush="Pink"
                    BorderThickness="2"
                    Margin="0,5,0,0"
                    Foreground="MediumVioletRed"
                    FontWeight="Bold"/>
                <ListViewItem
                    x:Name="cashierMenu"
                    Content="Kasszás"
                    MouseLeftButtonUp="osztalyMenu_MouseLeftButtonUp"
                    FontSize="14"
                    BorderBrush="Pink"
                    BorderThickness="2"
                    Margin="0,5,0,0"
                    Foreground="MediumVioletRed"
                    FontWeight="Bold"/>
                <ListViewItem
                    x:Name="managerMenu"
                    Content="Termek"
                    MouseLeftButtonUp="termekMenu_MouseLeftButtonUp"
                    FontSize="14"
                    BorderBrush="Pink"
                    BorderThickness="2"
                    Margin="0,5,0,0"
                    Foreground="MediumVioletRed"
                    FontWeight="Bold"/>
                <ListViewItem
                    x:Name="kilepesMenu"
                    Background="DarkRed"
                    Content="Bezárás"
                    MouseLeftButtonUp="kilepesMenu_MouseLeftButtonUp"
                    FontSize="14"
                    BorderBrush="Pink"
                    BorderThickness="2"
                    Margin="0,5,0,0"
                    Foreground="MediumVioletRed"
                    FontWeight="ExtraBold"/>
            </ListView>
        </StackPanel>
        <StackPanel x:Name="feladatPanel" DockPanel.Dock="Right" />
    </DockPanel>
</Window>
